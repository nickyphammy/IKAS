# Supabase (required for auth and data)
# Get these from: Supabase Dashboard → Project Settings → API
#
# Use the "anon public" key (starts with eyJ...) or "publishable" key (sb_publishable_...)
# NEVER use the secret key (sb_secret_) — that must never go in frontend code

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server/scripts only — never expose in frontend or commit real values
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
