{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/credentials*)",
      "Bash(sudo:*)"
    ],
    "allow": ["Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)"]
  }
}
