# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables (NEVER commit real keys)
.env
.env.*
!.env.example

# Supabase local CLI state (can contain linked project credentials)
supabase/.temp/
.branches
.temp
.supabase/

# Deployment tooling (project linking metadata)
.vercel/
.netlify/

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# Logs (can leak paths, tokens, or user data)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# NOTE: supabase/migrations/ and supabase/config.toml are intentionally tracked.
# Migrations are schema definitions (no secrets) and must be version-controlled.
